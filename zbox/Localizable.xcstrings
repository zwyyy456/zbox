        }
      }
    },
    "Accessibility permission is required to read text in other apps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取其他应用中的文本需要辅助功能权限。"
          }
        }
      }
    },
    "Accessibility-dependent features were disabled. Re-enable them after granting permission.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依赖辅助功能权限的功能已关闭。重新授权后请手动启用。"
