    "Text Lookup is disabled for this application.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用已禁用文本取词。"
          }
        }
      }
    },
    "Text Lookup reads selected text or text under the pointer only when triggered. Captured text stays in the current popup unless you create a FlashDict card. It does not use Screen Recording or keep lookup history.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本取词仅在触发时读取选区或鼠标指针下的文字。捕获内容只保留在当前弹窗中，除非你明确创建 FlashDict 闪卡；不会使用屏幕录制权限，也不会保存查词历史。"
          }
        }
      }
    },
    "The application that owned the window is no longer available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原窗口所属的应用已不可用。"
          }
