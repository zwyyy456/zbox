    },
    "The selected text could not be read.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取所选文本。"
          }
        }
      }
    },
    "The selection could not be read using clipboard compatibility mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法通过剪贴板兼容模式读取选区。"
          }
        }
      }
    },
    "The sentence could not be translated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法翻译此句。"
          }
        }
      }
    },
    "The sentence language could not be identified.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别句子语言。"
          }
        }
      }
    },
    "The shortcut is already used by %@ and %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The shortcut is already used by %1$@ and %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键已被 %1$@ 和 %2$@ 使用。"
          }
        }
      }
    },
    "The shortcut update failed (%@), and the previous shortcuts could not be restored (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The shortcut update failed (%1$@), and the previous shortcuts could not be restored (%2$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键更新失败（%1$@），且无法恢复原快捷键（%2$@）。"
          }
        }
      }
    },
    "The target application has no focused window.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标应用没有聚焦窗口。"
          }
        }
      }
    },
    "The target window does not support this operation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标窗口不支持此操作。"
          }
        }
      }
    },
    "The target window is not on an available display.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标窗口不在可用的显示器上。"
          }
        }
      }
    },
    "The target window position or size could not be read.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取目标窗口的位置或大小。"
          }
        }
      }
    },
    "This application does not expose text at this location.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用未公开该位置的文本。"
          }
        }
      }
    },
