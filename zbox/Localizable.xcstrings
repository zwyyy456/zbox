      }
    },
    "Unable to open %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开 %@。"
          }
        }
      }
    },
    "Update zbox and FlashDict to compatible versions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 zbox 和 FlashDict 更新到兼容版本。"
          }
        }
      }
    },
    "When Accessibility cannot read an existing selection, zbox may briefly simulate Copy and restore the clipboard if it has not changed. Pointer lookup never uses the clipboard.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当辅助功能无法读取已有选区时，zbox 可短暂模拟复制，并仅在剪贴板未被改动时恢复内容。鼠标指针取词不会使用剪贴板。"
          }
        }
      }
    },
    "Window Management": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口管理"
          }
        }
      }
    },
    "Window Management uses Accessibility only to move and resize the frontmost application window.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口管理仅使用辅助功能权限移动和缩放前台应用窗口。"
          }
        }
      }
    },
