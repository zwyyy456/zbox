          }
        }
      }
    },
    "Stores future copies on this Mac. History is not encrypted or synced. Sensitive markers and excluded apps are skipped, but not all secrets can be detected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
