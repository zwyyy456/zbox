          }
        }
      }
    },
    "Unable to Look Up Text": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法取词"
          }
        }
      }
    },
    "Unable to install the global hotkey handler (%d).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安装全局快捷键处理程序（%d）。"
