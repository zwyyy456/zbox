    "Expected ':' after the object key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对象键之后应为冒号。"
          }
        }
      }
    },
    "Expected a quoted object key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对象键必须使用双引号。"
          }
        }
