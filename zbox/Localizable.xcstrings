{
  "sourceLanguage": "en",
  "strings": {
    "%@ is already used by another app or could not be registered (%d).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is already used by another app or could not be registered (%2$d)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已被其他应用占用或无法注册（%2$d）。"
          }
        }
      }
    },
    "%@ shortcut": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 快捷键"
          }
        }
      }
    },
    "%lld applications": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个应用"
          }
        }
      }
    },
    "A dictionary resource is unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词典资源不可用。"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility permission is required to enable Text Lookup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用文本取词需要辅助功能权限。"
          }
        }
      }
    },
    "Accessibility permission is required to enable Window Management.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用窗口管理需要辅助功能权限。"
          }
        }
      }
    },
    "Accessibility permission is required to move windows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动窗口需要辅助功能权限。"
